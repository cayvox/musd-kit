{
  "name": "@musd-kit/example-keeper",
  "version": "0.0.2",
  "private": true,
  "description": "Headless MUSD liquidation keeper, depends on @musd-kit/core ONLY (no React/wagmi). Structural proof the core is framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/keeper.ts --format esm --target node20 --clean",
    "start": "node dist/keeper.js"
  },
  "dependencies": {
    "@mezo-org/chains": "0.0.1",
    "@musd-kit/core": "workspace:*",
    "viem": "^2.22.8"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "tsup": "8.3.5",
    "typescript": "5.7.3"
  }
}
