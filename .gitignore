# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# test / coverage
coverage/
.vitest/

# anvil / fork harness logs
anvil*.log
*.anvil.log

# env & secrets
.env
.env.*
!.env.example
# Local key material for the live testnet run (scripts/testnet-e2e.ts). The whole directory
# is ignored, not one filename, so a second key file cannot be added and tracked by accident.
# The script reads MEZO_TESTNET_PRIVATE_KEY from the ENVIRONMENT; this file is only where an
# operator keeps it between runs, and it is sourced, never read by path from the code.
.secrets/

# editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Agent tooling settings (MK-064). The whole directory, on the `.secrets/` reasoning above:
# a second settings file cannot then appear and be linted by accident. `biome.json` sets
# `vcs.useIgnoreFile`, which reads THIS file and not a contributor's global excludes, so
# without this line `pnpm lint` fails on a working tree that `git status` calls clean for
# anyone whose global excludes hide the same directory.
.claude/

# docs site (generated)
docs/public/api
docs/.vitepress/dist
docs/.vitepress/cache

# astro
landing/.astro/
landing/dist/
.astro/
