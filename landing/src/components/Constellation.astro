---
// Hero motif (BRAND §6): "the sorted list of positions" — a faint red constellation of
// nodes + hairlines (evoking Mezo's SortedTroves) behind the hero on the warm canvas. Slow
// drift + light scroll parallax; STATIC under reduced-motion. Lightweight inline SVG.
const nodes: [number, number, boolean][] = [
  [60, 430, false],
  [140, 360, false],
  [215, 455, false],
  [300, 300, false],
  [378, 405, true],
  [452, 250, false],
  [532, 360, false],
  [612, 205, false],
  [690, 330, false],
  [772, 262, true],
  [846, 402, false],
  [918, 300, false],
  [968, 470, false],
]
const chain = nodes.map((_, i) => i).slice(0, -1).map((i) => [i, i + 1])
const cross = [
  [3, 5],
  [6, 8],
  [9, 11],
]
const links = [...chain, ...cross]
---

<div class="motif" aria-hidden="true" data-motif>
  <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" role="presentation" focusable="false">
    <g class="motif__drift">
      {
        links.map(([a, b]) => (
          <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} class="motif__line" />
        ))
      }
      {
        nodes.map(([x, y, emph], i) => (
          <>
            {emph && <circle cx={x} cy={y} r="13" class="motif__halo" />}
            <circle cx={x} cy={y} r={emph ? 4.5 : 2.6} class={emph ? 'motif__node motif__node--on' : 'motif__node'} style={`--i:${i}`} />
          </>
        ))
      }
    </g>
  </svg>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const motif = document.querySelector<HTMLElement>('[data-motif] .motif__drift')
  if (motif && !reduce) {
    let raf = 0
    const update = () => {
      raf = 0
      motif.style.transform = `translateY(${Math.min(window.scrollY * 0.05, 50)}px)`
    }
    window.addEventListener('scroll', () => { if (!raf) raf = window.requestAnimationFrame(update) }, { passive: true })
  }
</script>

<style>
  .motif {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(115% 90% at 72% 32%, #000 30%, transparent 76%);
    mask-image: radial-gradient(115% 90% at 72% 32%, #000 30%, transparent 76%);
  }
  .motif svg {
    width: 100%;
    height: 100%;
  }
  .motif__line {
    stroke: var(--red);
    stroke-width: 1;
    opacity: 0.1;
  }
  .motif__node {
    fill: var(--red);
    opacity: 0.18;
  }
  .motif__node--on {
    opacity: 0.4;
  }
  .motif__halo {
    fill: var(--red);
    opacity: 0.08;
  }
  .motif__drift {
    transform-origin: center;
    animation: motif-drift 28s var(--ease) infinite alternate;
  }
  .motif__node--on {
    animation: motif-pulse 7s var(--ease) infinite alternate;
  }
  @keyframes motif-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-14px, -8px, 0) scale(1.015);
    }
  }
  @keyframes motif-pulse {
    from {
      opacity: 0.28;
    }
    to {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .motif__drift,
    .motif__node--on {
      animation: none;
    }
  }
</style>
