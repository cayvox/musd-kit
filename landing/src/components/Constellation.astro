---
// "The sorted list of positions" (BRAND §6): a faint constellation of nodes + hairlines
// evoking Mezo's SortedTroves. Low-opacity ember; a couple of nodes emphasized; slow
// drift + light scroll parallax; STATIC under reduced-motion. Lightweight inline SVG.
const nodes: [number, number, boolean][] = [
  [60, 420, false],
  [140, 360, false],
  [215, 455, false],
  [300, 300, false],
  [375, 400, true],
  [450, 250, false],
  [530, 360, false],
  [610, 205, false],
  [690, 330, false],
  [770, 260, true],
  [845, 400, false],
  [915, 300, false],
  [965, 470, false],
]
// sequential chain + a few cross-links (the "sorted" spine with branches)
const chain = nodes.map((_, i) => i).slice(0, -1).map((i) => [i, i + 1])
const cross = [
  [3, 5],
  [6, 8],
  [9, 11],
]
const links = [...chain, ...cross]
---

<div class="motif" aria-hidden="true" data-motif>
  <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" role="presentation" focusable="false">
    <g class="motif__drift">
      {
        links.map(([a, b]) => (
          <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} class="motif__line" />
        ))
      }
      {
        nodes.map(([x, y, emph], i) => (
          <>
            {emph && <circle cx={x} cy={y} r="14" class="motif__halo" />}
            <circle cx={x} cy={y} r={emph ? 4.5 : 2.8} class={emph ? 'motif__node motif__node--on' : 'motif__node'} style={`--i:${i}`} />
          </>
        ))
      }
    </g>
  </svg>
</div>

<script>
  // Light scroll parallax — disabled under reduced-motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const motif = document.querySelector<HTMLElement>('[data-motif] .motif__drift')
  if (motif && !reduce) {
    let raf = 0
    const update = () => {
      raf = 0
      motif.style.transform = `translateY(${Math.min(window.scrollY * 0.06, 60)}px)`
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!raf) raf = window.requestAnimationFrame(update)
      },
      { passive: true },
    )
  }
</script>

<style>
  .motif {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    /* fade the motif out toward the bottom so text stays clean */
    -webkit-mask-image: radial-gradient(120% 90% at 70% 30%, #000 35%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 70% 30%, #000 35%, transparent 78%);
  }
  .motif svg {
    width: 100%;
    height: 100%;
  }
  .motif__line {
    stroke: var(--ember-faint);
    stroke-width: 1;
  }
  .motif__node {
    fill: var(--ember-glow);
  }
  .motif__node--on {
    fill: var(--ember);
    opacity: 0.5;
  }
  .motif__halo {
    fill: var(--ember-glow);
    opacity: 0.5;
  }
  .motif__drift {
    transform-origin: center;
    animation: motif-drift 26s var(--ease) infinite alternate;
  }
  .motif__node--on {
    animation: motif-pulse 7s var(--ease) infinite alternate;
  }
  @keyframes motif-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-14px, -8px, 0) scale(1.015);
    }
  }
  @keyframes motif-pulse {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 0.7;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .motif__drift,
    .motif__node--on {
      animation: none;
    }
  }
</style>
