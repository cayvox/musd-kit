---
// CONTENT §6 + the flow diagram: Passport → wagmi context → musd-kit → Mezo contracts.
// musd-kit node emphasized in ember. Inline SVG in the brand style.
const stages = [
  { label: 'Passport', sub: 'wallet connect' },
  { label: 'wagmi context', sub: 'account · client' },
  { label: 'musd-kit', sub: 'the typed layer', on: true },
  { label: 'Mezo contracts', sub: 'Trove · oracle' },
]
---

<section class="section positioning" aria-labelledby="pos-h">
  <div class="container positioning__inner">
    <div class="positioning__text">
      <h2 id="pos-h" data-reveal>Passport connects the wallet. musd-kit operates MUSD.</h2>
      <p class="prose positioning__body" data-reveal>
        musd-kit is a complement to Mezo's Passport, not a replacement. Passport handles wallet connection; musd-kit is
        the typed interaction layer on top — the part that was missing. The core is framework-agnostic: the same logic
        powers a React dApp or a headless Node keeper.
      </p>
    </div>

    <div class="flow" role="img" aria-label="Data flow: Passport, then wagmi context, then musd-kit, then Mezo contracts" data-reveal>
      {
        stages.map((s, i) => (
          <>
            <div class={`flow__node${s.on ? ' flow__node--on' : ''}`}>
              <span class="flow__label">{s.label}</span>
              <span class="flow__sub">{s.sub}</span>
            </div>
            {i < stages.length - 1 && (
              <span class="flow__arrow" aria-hidden="true">
                <svg viewBox="0 0 28 12" width="28" height="12">
                  <path d="M0 6h24M19 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .positioning__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .positioning__text {
    max-width: var(--maxw-prose);
  }
  .positioning__body {
    margin-top: 1.25rem;
    font-size: var(--fs-h3);
    line-height: 1.6;
  }
  .flow {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .flow::-webkit-scrollbar {
    display: none;
  }
  .flow__node {
    flex: 1 0 auto;
    min-width: 8.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    background: var(--surface-2);
    border: 1px solid var(--hairline-2);
    border-radius: var(--radius-sm);
  }
  .flow__node--on {
    border-color: var(--ember);
    background: var(--ember-faint);
    box-shadow: 0 0 0 1px var(--ember) inset;
  }
  .flow__label {
    font-weight: 600;
    color: var(--text);
    font-size: 0.95rem;
  }
  .flow__node--on .flow__label {
    color: var(--ember-bright);
  }
  .flow__sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .flow__arrow {
    display: flex;
    align-items: center;
    color: var(--text-dim);
    flex: 0 0 auto;
  }
</style>
