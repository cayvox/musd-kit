---
import Playground from './Playground.astro'

// The live demo. The FULL interactive playground (richer than the hero teaser):
// sliders + presets, a color-coded safety bar, the price-drop-to-liquidation line, and a live,
// copyable SDK call. Read-only, testnet-only, lazy-loaded, with a graceful fallback.
---

<section class="section demo" id="demo" aria-labelledby="demo-h">
  <div class="container">
    <div class="demo__head">
      <p class="eyebrow eyebrow--red" data-reveal>LIVE DEMO</p>
      <h2 id="demo-h" data-reveal>Try it live.</h2>
      <p class="prose" data-reveal>
        Drag the sliders or pick a preset: the fee, total debt, collateral ratio and the price BTC can fall before
        liquidation all recompute from the real Mezo testnet oracle, through the shipped package.
      </p>
    </div>
    <div class="demo__widget" data-reveal>
      <Playground />
    </div>
  </div>
</section>

<style>
  .demo {
    background: var(--surface-2);
    border-block: 1px solid var(--hairline);
  }
  .demo__head {
    max-width: var(--maxw-prose);
  }
  .demo__head h2 {
    margin-top: 0.9rem;
  }
  .demo__head p {
    margin-top: 1rem;
  }
  .demo__widget {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    max-width: 780px;
  }
</style>
