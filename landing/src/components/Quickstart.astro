---
import TabbedCode from './TabbedCode.astro'

const install = `npm install @musd-kit/core`

const createRead = `import { createMusdClient } from '@musd-kit/core'

const musd = createMusdClient({ chainId, publicClient })
const price = await musd.getOraclePrice()
const trove = await musd.getTrove(address)`

const previewOpen = `const preview = await musd.previewOpen({
  collateral: parseBtc('0.05'),
  debt: parseMusd('2500'),
})

await musd.openTrove({ collateral: parseBtc('0.05'), debt: parseMusd('2500') })`
---

<section class="section quickstart" aria-labelledby="qs-h">
  <div class="container quickstart__inner">
    <div class="quickstart__head">
      <h2 id="qs-h" data-reveal>Start in two minutes.</h2>
      <p class="prose" data-reveal>
        Install the core, create a client, read live state, and preview an open — the same calls used across this page.
      </p>
      <div class="quickstart__links" data-reveal>
        <a class="btn btn--ember" href="/docs/">Read the full docs&nbsp;→</a>
        <a class="hero__textlink" href="/docs/api/">API reference&nbsp;→</a>
      </div>
    </div>
    <div class="quickstart__code" data-reveal>
      <TabbedCode
        tabs={[
          { label: 'install', code: install, lang: 'bash' },
          { label: 'create + read', code: createRead, lang: 'ts' },
          { label: 'preview + open', code: previewOpen, lang: 'ts' },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .quickstart__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 880px) {
    .quickstart__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .quickstart__head p {
    margin-top: 1.1rem;
  }
  .quickstart__links {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .btn--ember {
    background: var(--ember);
    color: #1a0f08;
    border: 1px solid var(--ember);
  }
  .btn--ember:hover {
    background: var(--ember-bright);
    border-color: var(--ember-bright);
    color: #1a0f08;
  }
  .quickstart__code {
    min-width: 0;
  }
</style>
