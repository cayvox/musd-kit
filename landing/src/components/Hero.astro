---
import HeroBackdrop from './HeroBackdrop.astro'
import CopyCommand from './CopyCommand.astro'
import Button from './Button.astro'
import PreviewWidget from './PreviewWidget.astro'
---

<section class="hero">
  <HeroBackdrop />
  <div class="container hero__inner">
    <div class="hero__copy">
      <a class="hero__oss" href="https://github.com/cayvox/musd-kit" rel="noopener">
        <svg class="hero__oss-mark" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="4" cy="3.6" r="1.5"></circle>
          <circle cx="4" cy="12.4" r="1.5"></circle>
          <circle cx="12" cy="5.2" r="1.5"></circle>
          <path d="M4 5.1v5.8M4 8h4.2A1.8 1.8 0 0 0 10 6.2v-.3"></path>
        </svg>
        <span class="hero__oss-text">Open source</span>
      </a>
      <h1 class="hero__title">Build on <span class="hero__accent">MUSD</span> <br class="hero__br" />without rebuilding <br class="hero__br" />the hard parts.</h1>
      <p class="hero__subhead">
        The typed, fork-verified TypeScript SDK for <strong>MUSD</strong>, Mezo's Bitcoin-backed stablecoin. The Trove
        lifecycle, the math, and the hint dance, handled.
      </p>
      <div class="hero__cta">
        <div class="hero__buttons">
          <Button href="/docs/" variant="primary">View Documentation</Button>
          <Button href="https://github.com/cayvox/musd-kit" rel="noopener" variant="ghost">GitHub&nbsp;→</Button>
        </div>
        <CopyCommand command="npm i @musd-kit/core @musd-kit/react" />
      </div>
    </div>

    <div class="hero__mockup">
      <PreviewWidget />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(1.75rem, 4vw, 3.25rem) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.25rem, 4vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .hero__inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }
  .hero__copy {
    min-width: 0;
  }
  /* refined "open source" lockup: the brand node-fork mark in red + mono label, a crafted signal
     distinct from the GitHub button (not a license pill). */
  .hero__oss {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lbl);
    letter-spacing: 0.02em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .hero__oss-mark {
    color: var(--red);
    flex-shrink: 0;
  }
  .hero__oss:hover {
    color: var(--red-ink);
  }
  .hero__title {
    font-size: clamp(2.3rem, 1.55rem + 2.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin-top: 1.1rem;
    max-width: 20ch;
    text-wrap: balance;
  }
  /* explicit 3-line break on desktop; natural wrap on mobile */
  .hero__br {
    display: none;
  }
  @media (min-width: 600px) {
    .hero__br {
      display: inline;
    }
    .hero__title {
      text-wrap: initial;
    }
  }
  .hero__accent {
    color: var(--red);
  }
  .hero__subhead {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .hero__subhead strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero__cta {
    margin-top: 1.85rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .hero__buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .hero__mockup {
    min-width: 0;
  }
</style>
