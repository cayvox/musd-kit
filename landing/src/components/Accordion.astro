---
// FAQ accordion primitive (BRAND §4), red chevron, height transition, keyboard + ARIA.
// Toggle logic lives in the global enhancement script (Base.astro).
interface Item {
  q: string
  a: string
}
interface Props {
  items: Item[]
}
const { items } = Astro.props
const uid = `acc-${Math.random().toString(36).slice(2, 8)}`
const mark = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<div class="accordion" data-accordion>
  {
    items.map((it, i) => (
      <div class="accordion__item">
        <button
          class="accordion__trigger"
          type="button"
          aria-expanded="false"
          id={`${uid}-t-${i}`}
          aria-controls={`${uid}-p-${i}`}
        >
          <span>{it.q}</span>
          <svg class="accordion__chevron" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M4 7l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="accordion__panel" id={`${uid}-p-${i}`} role="region" aria-labelledby={`${uid}-t-${i}`}>
          <div class="accordion__inner">
            <p class="accordion__body" set:html={mark(it.a)} />
          </div>
        </div>
      </div>
    ))
  }
</div>
