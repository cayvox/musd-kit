---
// CONTENT §5 — the proof panel. Each item is a verified fact; numbers in Geist Mono.
const proofs = [
  {
    title: 'Verified against real Mezo contracts',
    body: 'Not mocks. A fork harness backs the whole suite, plus a live testnet pass through the published packages.',
  },
  {
    title: 'Zero hardcoded governable values',
    metric: '0',
    body: 'Minimum debt, fees, interest rate and redemption rate are all read on-chain, so the SDK stays correct when governance changes them.',
  },
  {
    title: 'Preview ↔ on-chain parity to the wei',
    body: 'What previewOpen predicts equals what the contract does, exactly.',
  },
  {
    title: 'Optimal insertion hints',
    metric: 'gas Δ = 0',
    body: 'Zero gas difference versus near-exact hints on the live list.',
  },
  {
    title: 'The harness caught three load-bearing bugs',
    metric: '3',
    body: 'A wrong minimum-debt assumption, a stale-interest getter, and a redemption-fee rule that doesn’t match Mezo’s docs. Hardcoding any would have shipped silently-wrong numbers.',
  },
  {
    title: 'Proven live on Mezo testnet',
    metric: '$66,395.81',
    body: 'A real read through the shipped package returned BTC/USD $66,395.81 and a system TCR of 194.9% via Mezo’s native oracle.',
  },
  {
    title: 'A headless keeper liquidated real Troves',
    metric: '400 MUSD',
    body: 'Core-only, no React; it closed two under-collateralized positions and collected the 400 MUSD reward.',
  },
  {
    title: '80+ tests · ESM + CJS · MIT',
    metric: '80+',
    body: 'Dual module formats, broad coverage, permissively licensed.',
  },
]
---

<section class="section correctness" aria-labelledby="corr-h">
  <div class="container">
    <div class="correctness__head">
      <p class="eyebrow eyebrow--ember" data-reveal>WHY TRUST IT</p>
      <h2 id="corr-h" data-reveal>Correctness is the product.</h2>
      <p class="lead correctness__lead" data-reveal>
        Most SDKs ask you to trust them. musd-kit was built against a fork of real Mezo and verified on testnet — so the
        proof is checkable, not promised.
      </p>
    </div>

    <ul class="proofgrid" role="list">
      {
        proofs.map((p) => (
          <li class="proof" data-reveal>
            <span class="proof__check" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14">
                <path
                  d="M3 8.5l3.2 3.2L13 4.8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <div class="proof__content">
              <p class="proof__title">
                {p.title}
                {p.metric && <span class="proof__metric">{p.metric}</span>}
              </p>
              <p class="proof__body">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="correctness__caption" data-reveal>
      See the verification ledger and ground-truth in the <a href="/docs/01-ground-truth">docs</a>.
    </p>
  </div>
</section>

<style>
  .correctness {
    background: var(--surface);
    border-block: 1px solid var(--hairline);
  }
  .correctness__head {
    max-width: var(--maxw-prose);
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }
  .correctness__head h2 {
    margin-top: 0.9rem;
  }
  .correctness__lead {
    margin-top: 1.4rem;
    color: var(--text-muted);
    font-weight: 400;
  }
  .proofgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .proofgrid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 980px) {
    .proofgrid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .proof {
    display: flex;
    gap: 0.85rem;
    padding: 1.4rem;
    background: var(--surface-2);
  }
  .proof__check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--verified);
    background: color-mix(in srgb, var(--verified) 14%, transparent);
    margin-top: 0.1rem;
  }
  .proof__title {
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.35;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .proof__metric {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ember);
    background: var(--ember-faint);
    border: 1px solid color-mix(in srgb, var(--ember) 22%, transparent);
    padding: 0.05rem 0.4rem;
    border-radius: 5px;
    white-space: nowrap;
  }
  .proof__body {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }
  .correctness__caption {
    margin-top: 1.5rem;
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
</style>
