---
// Copy-command pill. Styling lives in global .cmd; copy logic is global.
interface Props {
  command: string
}
const { command } = Astro.props
---

<div class="cmd">
  <span class="cmd__prompt" aria-hidden="true">$</span>
  <code class="cmd__text">{command}</code>
  <button class="cmd__copy" type="button" data-copy={command} aria-label={`Copy: ${command}`}>
    <span class="codeblock__copy-text">Copy</span>
  </button>
</div>
