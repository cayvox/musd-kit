{
  "name": "musd-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript client SDK for MUSD, Mezo's Bitcoin-backed stablecoin (community tooling).",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "20.17.10",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.7.3",
    "viem": "2.22.8",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
