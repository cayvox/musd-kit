{
  "name": "musd-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript client SDK for MUSD, Mezo's Bitcoin-backed stablecoin (community tooling).",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.20.2"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p docs/tsconfig.json",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:fork": "vitest run --project fork",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc && node scripts/brand-api-icons.mjs",
    "docs:build": "pnpm docs:api && pnpm --filter @musd-kit/docs build",
    "build:site": "bash scripts/build-site.sh",
    "serve:site": "node scripts/serve-site.mjs",
    "preview:site": "pnpm build:site && pnpm serve:site",
    "check:links": "node scripts/check-links.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "testnet:e2e": "tsx scripts/testnet-e2e.ts",
    "facts": "tsx scripts/onchain-facts.ts",
    "gate:packaging": "node scripts/packaging-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.27.10",
    "@mezo-org/chains": "0.0.1",
    "@musd-kit/core": "workspace:*",
    "@types/node": "20.17.10",
    "@vitest/coverage-v8": "2.1.8",
    "tsx": "4.19.2",
    "typedoc": "0.27.6",
    "typescript": "5.7.3",
    "viem": "2.22.8",
    "vitepress": "1.5.0",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
